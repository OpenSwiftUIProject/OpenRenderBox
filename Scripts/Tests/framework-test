#!/bin/bash
set -euo pipefail

framework="${1:?Usage: framework-test /path/to/OpenRenderBox.framework}"
test_root=$(mktemp -d)
trap 'rm -rf "$test_root"' EXIT
ditto "$framework" "$test_root/OpenRenderBox.framework"
cd "$test_root"

case "$(xcrun otool -L OpenRenderBox.framework/OpenRenderBox)" in
    *OpenRenderBoxCxx*)
        echo "OpenRenderBox must not depend on a dynamic OpenRenderBoxCxx library." >&2
        exit 1
        ;;
esac

if [[ -n "$(find -L OpenRenderBox.framework/Resources -type f -name '*.tpp' -print -quit)" ]]; then
    echo "Template headers must be exported under Headers, not bundled as resources." >&2
    exit 1
fi

# Use only the bundle, including its Swift interface, to detect source-path dependencies.
for module in OpenRenderBox.framework/Modules/OpenRenderBox.swiftmodule/*.swiftmodule; do
    test ! -f "$module" || rm "$module"
done
for header in OpenRenderBox.framework/Headers/*.h; do
    if [[ -L "$header" || ! -f "$header" ]]; then
        echo "Framework headers must be regular files: $header" >&2
        exit 1
    fi
    printf '#include <OpenRenderBox/%s>\n' "${header##*/}"
done > public-headers.h

cat > client.c <<'EOF'
#include "public-headers.h"
#include <assert.h>

int main(void) {
    ORBColor color = ORBColorMake(1, 0, 0, 1);
    assert(color.red == 1 && color.alpha == 1);
    assert(ORBPathIsEmpty(ORBPathEmpty));
    assert(ORBPathIsNull(ORBPathNull));
    bool (*storageIsEmpty)(ORBPathStorageRef) = ORBPathStorageIsEmpty;
    assert(storageIsEmpty != NULL);
    return 0;
}
EOF

cat > client.cpp <<'EOF'
#include "public-headers.h"
#include <OpenRenderBox/Animation/Animation.hpp>
#include <cassert>

int main() {
    ORB::Animation animation;
    assert(animation.empty());
    animation.add_spring(1, 1, 1, 1, 0);
    assert(!animation.empty());
    assert(ORBPathIsEmpty(ORBPathEmpty));
}
EOF

cat > client.m <<'EOF'
#include <OpenRenderBox/ORBSymbolAnimator.h>
#include <OpenRenderBox/ORBSymbolAnimatorObserver.h>
#include <OpenRenderBox/ORBSymbolAnimation.h>
#include <OpenRenderBox/ORBTransition.h>
#include <assert.h>

int main(void) {
    ORBAnimation *animation = [ORBAnimation new];
    [animation removeAll];
    assert(animation.activeDuration == 0);
    ORBSymbolAnimationOptionKey key = ORBSymbolAnimationSpeed;
    assert([key isEqualToString:@"speed"]);
    ORBSymbolAnimator *animator = [ORBSymbolAnimator new];
    assert(animator != nil);
    ORBTransition *transition = [ORBTransition new];
    assert(transition != nil);
    assert(ORBPathIsEmpty(ORBPathEmpty));
    return 0;
}
EOF

cat > client.swift <<'EOF'
import OpenRenderBox

precondition(ORBColor.black.alpha == 1)
precondition(ORBPath.empty.isEmpty)
precondition(ORBPath.null.isNull)
let animation = ORBAnimation()
animation.removeAll()
precondition(animation.activeDuration == 0)
precondition(ORBSymbolAnimation.OptionKey.speed.rawValue == "speed")
EOF

target="$(uname -m)-apple-macos15.0"
common=(-target "$target" -F "$test_root" -framework OpenRenderBox -Wl,-rpath,"$test_root")
# Each guarded header must expose its API without another header setting the backend first.
for declaration in CFCGTypes.h:CGFloat ORBPath.h:ORBPath ORBPathCallbacks.h:ORBPathCallbacks ORBPathStorage.h:ORBPathStorageRef; do
    printf '#include <OpenRenderBox/%s>\n%s value;\n' "${declaration%:*}" "${declaration#*:}" > path-header.c
    xcrun clang -target "$target" -F "$test_root" -fsyntax-only path-header.c
done
for declaration in Path/Storage.hpp:ORB::Path::Storage Path/NestedCallbacks.hpp:ORB::Path::NestedCallbacks; do
    printf '#include <OpenRenderBox/%s>\nstatic_assert(sizeof(%s) > 0);\n' "${declaration%%:*}" "${declaration#*:}" > path-header.cpp
    xcrun clang++ -target "$target" -F "$test_root" -std=c++20 -fsyntax-only path-header.cpp
done
if xcrun clang -target "$target" -F "$test_root" -DOPENRENDERBOX_CF_CGTYPES=0 \
    -fsyntax-only path-header.c > backend-conflict.log 2>&1; then
    echo "The framework must reject a conflicting backend setting." >&2
    exit 1
fi
grep -Fq 'requires OPENRENDERBOX_CF_CGTYPES=1' backend-conflict.log
xcrun clang "${common[@]}" client.c -o client-c
./client-c
xcrun clang++ "${common[@]}" -std=c++20 client.cpp -o client-cxx
./client-cxx
xcrun clang "${common[@]}" -fmodules -fmodules-cache-path=clang-modules -fobjc-arc -framework Foundation client.m -o client-objc
./client-objc
xcrun swiftc -target "$target" -F "$test_root" -framework OpenRenderBox \
    -module-cache-path swift-modules -Xlinker -rpath -Xlinker "$test_root" client.swift -o client-swift
./client-swift

echo "Framework clients passed: C, C++, Objective-C, and Swift."
